# ── Google Sheets (서비스 계정) ─────────────────────────────
# 스프레드시트 URL의 /d/ 와 /edit 사이 문자열
GOOGLE_SHEETS_SPREADSHEET_ID=

# 서비스 계정 이메일 (xxx@xxx.iam.gserviceaccount.com)
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# 서비스 계정 키(JSON)의 private_key 값. 줄바꿈은 \n 으로 이스케이프해서 한 줄로 넣기
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# ── Google Calendar (OAuth) ────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# 배포된 주소 + /api/auth/google/callback (예: https://your-app.vercel.app/api/auth/google/callback)
GOOGLE_OAUTH_REDIRECT_URI=
# /api/auth/google 방문 후 최초 1회 인가하면 콘솔에 출력되는 값을 여기에 채워 넣기
GOOGLE_OAUTH_REFRESH_TOKEN=
# 일정 등록할 캘린더 ID (기본 캘린더는 primary)
GOOGLE_CALENDAR_ID=primary

# ── 지도 연동 ───────────────────────────────────────────────
# 카카오 로컬 API를 쓰는 경우에만 필요 (주소 → 좌표 변환용, 없으면 주소 검색 링크로 대체)
KAKAO_REST_API_KEY=
